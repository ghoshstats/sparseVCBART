Sys.setenv(MAKEFLAGS = "-j1")
Rcpp::compileAttributes(".")
devtools::clean_dll(".")
devtools::install(".", upgrade = "never", args = c("--no-multiarch", "--preclean"))
################################################################################
# ---- Setup ----
library(sparseVCBART)
set.seed(1)
# ---- Simulate longitudinal data ----
n_subj <- 60                     # number of subjects
ni     <- rep(5, n_subj)        # measurements per subject
N      <- sum(ni)
subj_id <- rep(seq_len(n_subj), times = ni)
# effect modifier (continuous)
z <- runif(N)                     # in [0,1]
# two covariates (no intercept here; package adds it internally)
x1 <- rnorm(N)
x2 <- rnorm(N)
X  <- cbind(x1, x2)               # N x 2
# True coefficient functions
beta0 <- function(z) 1 + 0.5 * sin(2*pi*z)   # intercept
beta1 <- function(z) 2 * (z - 0.5)           # for x1
beta2 <- function(z) cos(2*pi*z)             # for x2
# Errors: choose sigma and rho (rho used only for CS simulation below)
sigma_true <- 0.5
rho_true   <- 0.6
# Simulate compound-symmetric errors by subject
#  eps_it = sigma * ( sqrt(rho)*eta_i + sqrt(1-rho)*xi_it )
eta <- rnorm(n_subj)
eps <- numeric(N)
start <- 1
for (i in seq_len(n_subj)) {
m  <- ni[i]
id <- start:(start + m - 1)
eps[id] <- sigma_true * ( sqrt(rho_true) * eta[i] + sqrt(1 - rho_true) * rnorm(m) )
start <- start + m
}
# Response
Y <- beta0(z) + x1 * beta1(z) + x2 * beta2(z) + eps
# Modifier matrices (continuous & categorical)
Z_cont <- matrix(z, ncol = 1)           # N x 1
Z_cat  <- matrix(0L, nrow = 1, ncol = 1)  # not used; keep default shape harmlessly
make_cutpoints <- function(Z_cont, n_cuts = 25) {
if (!is.matrix(Z_cont)) Z_cont <- as.matrix(Z_cont)
out <- vector("list", ncol(Z_cont))
for (r in seq_len(ncol(Z_cont))) {
z <- Z_cont[, r]
# interior quantiles (drop endpoints)
qs <- unique(as.numeric(stats::quantile(z, probs = seq(0, 1, length.out = n_cuts + 2))))
out[[r]] <- qs[-c(1, length(qs))]
}
out
}
cp <- make_cutpoints(Z_cont, n_cuts = 25)
fit_ind <- VCBART_ind(
Y_train        = Y,
subj_id_train  = subj_id,
ni_train       = ni,
X_train        = X,
Z_cont_train   = Z_cont,
Z_cat_train    = matrix(0L, nrow = 1, ncol = 1),
cutpoints_list = cp,           # <-- IMPORTANT
M = 40, nd = 600, burn = 400,
save_samples = TRUE, save_trees = TRUE,
verbose = FALSE
)
# Quick diagnostics
rmse_ind <- sqrt(mean( (fit_ind$yhat.train.mean - Y)^2 ))
cat(sprintf("\n[IND] RMSE (train): %.3f   sigma_hat (mean): %.3f\n",
rmse_ind, mean(fit_ind$sigma)))
fit_cs <- VCBART_cs(
Y_train        = Y,
subj_id_train  = subj_id,
ni_train       = ni,
X_train        = X,
Z_cont_train   = Z_cont,
Z_cat_train    = matrix(0L, nrow = 1, ncol = 1),
cutpoints_list = cp,           # <-- IMPORTANT
rho = 0.3,
M = 40, nd = 600, burn = 400,
save_samples = TRUE, save_trees = TRUE,
verbose = FALSE
)
rmse_cs <- sqrt(mean( (fit_cs$yhat.train.mean - Y)^2 ))
cat(sprintf("[CS ] RMSE (train): %.3f   sigma_hat (mean): %.3f   rho_hat (mean): %.3f\n",
rmse_cs, mean(fit_cs$sigma), mean(fit_cs$rho)))
z_grid <- seq(0, 1, length.out = 100)
Zc_pred <- cbind(z_grid)
Zk_pred <- matrix(0L, nrow = length(z_grid), ncol = 1)
betas_ind_draws <- predict_betas(fit_ind, Z_cont = Zc_pred, Z_cat = Zk_pred, verbose = FALSE)
betas_cs_draws  <- predict_betas(fit_cs,  Z_cont = Zc_pred, Z_cat = Zk_pred, verbose = FALSE)
betas_ind_sum <- summarize_beta(betas_ind_draws)
betas_cs_sum  <- summarize_beta(betas_cs_draws)
plot_beta <- function(sum_obj, j, main, truth_fun) {
truth <- truth_fun(z_grid)
matplot(z_grid,
cbind(sum_obj[, "MEAN", j], sum_obj[, "L95", j], sum_obj[, "U95", j]),
type = "l", lty = c(1,2,2), lwd = 2, xlab = "z", ylab = bquote(beta[.(j-1)](z)),
main = main)
lines(z_grid, truth, col = "gray40", lwd = 2)
legend("topright", c("Posterior mean","95% CrI","Truth"),
lty = c(1,2,1), lwd = 2, col = c("black","black","gray40"), bty = "n")
}
par(mfrow = c(2,3), mar = c(4,4,2,1))
plot_beta(betas_ind_sum, 1, "IND: beta0(z)", function(z) 1 + 0.5*sin(2*pi*z))
plot_beta(betas_ind_sum, 2, "IND: beta1(z)", function(z) 2*(z-0.5))
plot_beta(betas_ind_sum, 3, "IND: beta2(z)", function(z) cos(2*pi*z))
plot_beta(betas_cs_sum,  1, "CS: beta0(z)",  function(z) 1 + 0.5*sin(2*pi*z))
plot_beta(betas_cs_sum,  2, "CS: beta1(z)",  function(z) 2*(z-0.5))
plot_beta(betas_cs_sum,  3, "CS: beta2(z)",  function(z) cos(2*pi*z))
par(mfrow = c(1,1))
set.seed(1)
n_i  <- 5; nsub <- 120; ni <- rep(n_i, nsub); N <- sum(ni)
z  <- runif(N); x1 <- rnorm(N); x2 <- rnorm(N); X <- cbind(x1, x2); Zc <- cbind(z)
beta0 <- 1 + 0.6*(z > 0.5) - 0.3*(z > 0.85)
beta1 <- 1.0*sin(2*pi*z)
beta2 <- -0.5*(z - 0.5)^2
y <- beta0 + beta1*x1 + beta2*x2 + rnorm(N, 0, 0.3)
subj_id <- rep(seq_len(nsub), each = n_i)
fit_demo2 <- VCBART_ind(
Y_train = y,
subj_id_train = subj_id,
ni_train = ni,
X_train = X,
Z_cont_train = Zc,
# no categorical modifiers
Z_cat_train  = matrix(0L, 1, 1),
# plenty of z cutpoints (avoid too-coarse grids)
cutpoints_list = list(unique(quantile(z, probs = seq(0,1,length.out = 41)))[-c(1,41)]),
sparse = FALSE,                 # <— turn off modifier selection
tau = c(4, 3, 3)/sqrt(20),      # <— looser per-leaf prior
M = 20,                         # <— fewer trees → larger per-tree effect
nd = 800, burn = 400,
save_samples = TRUE, save_trees = TRUE,
verbose = FALSE
)
# plot posterior means (now rescaled)
Zplot <- cbind(seq(0,1,length.out=201))
Bh    <- predict_betas(fit_demo2, Z_cont = Zplot, Z_cat = matrix(0L, nrow(Zplot), 1), verbose = FALSE)
Bbar  <- apply(Bh, c(2,3), mean)      # ngrid x p (p = 1+2): [intercept, beta1, beta2]
matplot(Zplot[,1], Bbar[,2:3], type="l", lwd=2, lty=1,
xlab="z", ylab="beta_j(z)", main="Posterior means (β1, β2)")
legend("topright", legend=c("beta1(z)","beta2(z)"), col=1:2, lty=1, bty="n")
c(
cor = cor(y, fit_demo2$yhat.train.mean),
rmse = sqrt(mean((y - fit_demo2$yhat.train.mean)^2))
)
# (B) Do the in-sample β means vary at all?
apply(fit_demo2$betahat.train.mean, 2, function(v) diff(range(v)))
beta1
?VCBART_ind
remove.packages("sparseVCBART")
